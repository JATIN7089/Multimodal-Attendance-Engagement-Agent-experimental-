# Copy to .env for local runs, or paste these into your host's dashboard.
# The app reads real environment variables; it does not load .env by itself.

# PostgreSQL connection string. Required on serverless hosts such as Vercel.
# Leave unset to use SQLite locally.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Long random value used to sign session cookies.
# Generate one with: python -c "import secrets;print(secrets.token_hex(32))"
# If omitted, the app generates one and stores it in the database.
# SECRET_KEY=

# Where the SQLite file lives when DATABASE_URL is not set.
# PULSE_DB_PATH=/data/pulse_users.db
